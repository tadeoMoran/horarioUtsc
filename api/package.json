{
  "name": "horarioutsc-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "API REST de HorarioUTSC (Express + PostgreSQL)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "db:check": "node scripts/verificar-esquema.mjs",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql",
    "admin:crear": "node scripts/crear-admin.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1"
  },
  "main": "src/server.js",
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
